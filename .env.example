# Copy to .env and adjust. Never commit the real .env.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=wallet
# Use a strong, generated value outside local development.
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet
POSTGRES_TEST_DB=wallet_test
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Application ------------------------------------------------------------
ENVIRONMENT=local            # local | test | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
API_PORT=8000

# Turn the OpenAPI schema and Swagger UI off for a public deployment.
DOCS_ENABLED=true

# --- Tuning -----------------------------------------------------------------
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=3000
DB_RETRY_ATTEMPTS=3
MAX_OPERATION_AMOUNT=1000000000
